# Supabase (proyecto NUEVO del ERP, no el del CRM) — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Solo servidor — NUNCA con prefijo NEXT_PUBLIC_. Todas las tablas tienen RLS
# sin políticas: el servidor accede con esta clave tras comprobar que eres admin@.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Repositorio de facturas (OneDrive de info@) ─────────────────────────────
# Mismos valores que el proveedor Azure de Supabase (registro "ERP Carmen Fontes").
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Cifra el refresh token de Microsoft guardado en la BBDD. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Enlace de la carpeta «01. Facturas» compartida por info@ con admin@ (solo lectura).
ONEDRIVE_FOLDER_URL=
# Ejercicios anteriores se ignoran.
REPOSITORY_FROM_YEAR=2026
# Lectura de facturas con Claude.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Pasos siguientes (aún no se usan) ───────────────────────────────────────
# RPA "Sincronizar Gestión": usuario de Optimydent (mismo que OptiDev).
# OPTIMYDENT_USER=
# OPTIMYDENT_PASSWORD=
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" en los crons.
# CRON_SECRET=
